# Forklift Sales Machine backend bridge
FSM_BACKEND_URL=https://vortex-forklift-api-production.up.railway.app
FSM_BACKEND_EMAIL=
FSM_BACKEND_PASSWORD=

# Backward-compatible production names currently used by the Vercel storefront.
# Prefer email/password for newly rotated auth unless we intentionally manage
# a durable service token.
FSM_API_BASE=
FSM_SERVICE_JWT=

# Optional: only needed if this storefront is allowed to execute Publish Button POSTs.
# Leave unset for public read-only inventory/status/payload behavior.
FSM_PUBLISH_BRIDGE_TOKEN=

# David AI Configuration
GEMINI_API_KEY=
SIMLI_API_KEY=
SIMLI_FACE_ID=
NEXT_PUBLIC_SIMLI_FACE_ID=

# OpenAI TTS
OPENAI_API_KEY=
OPENAI_TTS_VOICE=
OPENAI_TTS_MODEL=

# ElevenLabs optional fallback
ELEVENLABS_API_KEY=

# Deepgram optional STT
DEEPGRAM_API_KEY=
